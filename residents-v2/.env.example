# Supabase (REST API + Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Прямое postgres-подключение для Prisma.
# Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.your-project-ref:5432/postgres?sslmode=require

# JWT
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=7d

# SMTP (отправка писем)
SMTP_HOST=smtp.skaz-kray.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@skaz-kray.ru
SMTP_PASS=change-me
SMTP_FROM=noreply@skaz-kray.ru

# Telegram Bot
SKAZKRAY_BOT_TOKEN=your-bot-token
SKAZKRAY_WEBHOOK_SECRET=your-webhook-secret

# Медиа-канал «Skaz-Kray Media»: туда уходят фото из редактора и приложения,
# оттуда они же публично раздаются через /tg-media/<file_id>.jpg.
# TG_UPLOAD_PASSWORD_HASH — bcrypt-хеш пароля редактора (того же, что на /editor/),
# сгенерировать: node -e "console.log(require('bcryptjs').hashSync('пароль',10))"
TG_MEDIA_BOT_TOKEN=
TG_MEDIA_CHAT_ID=
TG_UPLOAD_PASSWORD_HASH=

# Vercel Cron: секрет для ротации дежурного (совпадает с CRON_SECRET в
# Vercel Dashboard → Settings → Environment Variables — Vercel шлёт его сам в
# Authorization: Bearer). Без него cron-роут отвечает 403.
CRON_SECRET=

# Казначей: одобряет/отклоняет расходы задач кнопками в Telegram
COUNCIL_EXPENSE_APPROVER=Сергей Шубин
SKAZKRAY_GROUP_CHAT_ID=-1001580770653
SKAZKRAY_WATER_ALERT_CHAT_ID=-1002339206250
# Ссылка-инвайт в группу жителей для gate-экрана (её же задаёт сайт
# переменной PUBLIC_SKAZKRAY_GROUP_LINK — обе должны совпадать)
SKAZKRAY_GROUP_LINK=

# MAX Bot
SKAZKRAY_MAX_BOT_TOKEN=your-max-bot-token
SKAZKRAY_MAX_GROUP_CHAT_ID=your-max-group-chat-id

# Диплинки мини-приложения Совета в уведомлениях (порт council_app_link / max.app_link
# из residents/config/config.example.php). Если не заданы — дефолты легаси.
COUNCIL_APP_LINK=https://t.me/SkazKray_bot/sovet
COUNCIL_MAX_APP_LINK=https://max.ru/id643900558807_2_bot?startapp

# Файлы (загрузки)
UPLOADS_DIR=./uploads
BASE_URL=https://skaz-kray.ru

# Сессия (если нужна)
SESSION_SECRET=change-this-too
