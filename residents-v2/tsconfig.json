{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // api/ здесь не перечисляем: rootDir=src не пускает чужие файлы, а Vercel
  // компилирует её сам. Проверка типов api/ — в tsconfig.api.json.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
