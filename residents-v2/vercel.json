{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "prisma generate && tsc",
  "installCommand": "npm ci",

  "framework": null,

  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/api/(.+)/",
      "destination": "/api/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/:path*"
        }
      ]
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://skaz-kray.ru" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Content-Length, Content-Type, Authorization"
        }
      ]
    }
  ]
}
