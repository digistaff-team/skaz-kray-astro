# Секреты раздела жителей. Скопировать как config/.env (вне git, chmod 640
# root:www-data) и заполнить. Читается src/Env.php в bootstrap.php.

# Токен бота @SkazKray_bot (BotFather) — для проверки Telegram initData и
# членства в группе жителей (getChatMember). Бот должен состоять в группе.
SKAZKRAY_BOT_TOKEN=

# Токен бота MAX (@SkazKray_bot в MAX) — для проверки initData мини-приложения
# MAX (MaxWebApp::verify). Берётся в платформе MAX для партнёров.
SKAZKRAY_MAX_BOT_TOKEN=

# chat_id группы жителей в MAX — гейт входа жителей (/max). Узнаётся после
# добавления бота в группу: GET botapi.max.ru/chats. Не секрет; можно и в
# config.php (max.group_chat_id). Пусто → вход жителей через MAX не работает.
SKAZKRAY_MAX_GROUP_CHAT_ID=

# Ссылка-приглашение в группу жителей MAX — для экрана гейта («Вступить в группу»).
# Берётся из /chats (поле link) или из настроек группы.
SKAZKRAY_MAX_GROUP_LINK=

# Сервисный ключ доступа приложения VK ID — для пересылки постов группы «Вече»
# в Telegram-рассылку (bin/vk-vechesk-sync.php). Лежит в кабинете VK ID:
# Мои приложения → приложение → Ключи доступа → Сервисный ключ доступа.
#
# Почему именно он: wall.get не работает ни с ключом сообщества (ERR 27
# «method is unavailable with group auth»), ни с токеном пользователя VK ID
# (у VK ID нет права wall). Сервисный ключ статичный — не истекает, refresh не
# нужен. Пусто → cron-прогон падает с ошибкой и ничего не отправляет.
VK_VECHESK_SERVICE_TOKEN=
