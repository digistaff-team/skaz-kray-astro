---
import { footerNav, social, site } from '../data/nav.js';
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="footer-name">Сказочный Край</span>
      <p class="footer-tag">{site.tagline}<br /><span class="footer-address">Краснодарский край, Северский район,<br />рядом со станицей Григорьевская</span></p>
      <div class="footer-social">
        {social.map((s) => (
          <a href={s.url} target="_blank" rel="noopener" class="social-link">{s.title}</a>
        ))}
      </div>
    </div>

    <nav class="footer-nav" aria-label="Навигация в подвале">
      <ul>
        {footerNav.map((item) => (
          <li><a href={item.url}>{item.title}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="footer-bar">
    <div class="wrap footer-bar-inner">
      <span>{site.copyright}</span>
      <a href="/kontakty/">Связаться с нами</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--ground-2);
    border-top: 1px solid var(--line);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    padding-top: 3rem;
    padding-bottom: 2.5rem;
  }
  .footer-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--green-deep);
  }
  .footer-tag { color: var(--muted); font-size: var(--step-0); margin: 0.5rem 0 1rem; max-width: 42ch; }
  .footer-address { font-size: var(--step--1); }
  .footer-social { display: flex; gap: 0.6rem; }
  .social-link {
    display: inline-flex; align-items: center;
    padding: 0.4em 0.9em;
    font-size: var(--step--1); font-weight: 700;
    border: 1.5px solid var(--green);
    border-radius: 999px; color: var(--green);
  }
  .social-link:hover { background: var(--green); color: #fff; text-decoration: none; }

  .footer-nav ul {
    list-style: none; margin: 0; padding: 0;
    columns: 2; column-gap: 1.5rem;
  }
  .footer-nav li { margin-bottom: 0.55rem; break-inside: avoid; }
  .footer-nav a { color: var(--ink); font-size: var(--step-0); }
  .footer-nav a:hover { color: var(--green); }

  .footer-bar { border-top: 1px solid var(--line); }
  .footer-bar-inner {
    display: flex; justify-content: space-between; align-items: center;
    gap: 1rem; flex-wrap: wrap;
    padding-top: 1.1rem; padding-bottom: 1.1rem;
    font-size: var(--step--1); color: var(--muted);
  }

  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
