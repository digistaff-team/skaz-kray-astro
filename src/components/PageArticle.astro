---
const { entry } = Astro.props;
const { title } = entry.data;
const hasBody = (entry.body || '').trim().length > 0;
---
<article class="page">
  <header class="page-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
      </nav>
      <h1>{title}</h1>
    </div>
  </header>

  {hasBody
    ? <div class="wrap page-body prose" set:html={entry.body}></div>
    : <div class="wrap page-body"><p class="empty">Материал этой страницы скоро появится.</p></div>}
</article>

<style>
  .page-head { padding: 2.6rem 0 1.4rem; border-bottom: 1px solid var(--line); background: var(--ground-2); }
  .crumbs { font-size: var(--step--1); color: var(--muted); margin-bottom: 0.8rem; }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--green); }
  .page-body { max-width: 820px; padding-top: 2rem; padding-bottom: 1rem; }
  .page-body :global(p), .page-body :global(li) { font-size: var(--step-0); }
  .empty { color: var(--muted); }
</style>
