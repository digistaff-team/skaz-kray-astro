---
import '@fontsource/pt-serif/cyrillic-400.css';
import '@fontsource/pt-serif/cyrillic-700.css';
import '@fontsource/pt-serif/cyrillic-400-italic.css';
import '@fontsource/pt-sans/cyrillic-400.css';
import '@fontsource/pt-sans/cyrillic-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TelegramMiniApp from '../components/TelegramMiniApp.astro';

// bare — экраны разделов приложения (жители /poselenie/* и совет /sovet/*):
// без сайтового хедера/футера, как app/layout.php и council/layout.php в
// легаси. Дефолт — по префиксу пути, чтобы правило держалось на всех
// страницах разделов (и будущих тоже); можно переопределить пропом.
// sovet — экраны Попечительского совета: свой манифест (manifest-sovet,
// scope '/sovet/'), подпись в iOS и residents.css — общий стиль разделов.
const {
  title, description, image, type = 'website', noindex = false,
  bare = Astro.url.pathname.startsWith('/poselenie') || Astro.url.pathname.startsWith('/sovet'),
  sovet = Astro.url.pathname.startsWith('/sovet'),
} = Astro.props;
const fullTitle = title ? `${title} — Сказочный Край` : 'Сказочный Край — поселение родовых поместий в Краснодарском крае';
const desc = description || 'Поселение родовых поместий Сказочный Край в Северском районе Краснодарского края. Жизнь в гармонии с природой, свободные участки, дневники поместий.';
// og:image — абсолютный URL (соцсети/мессенджеры не принимают относительные).
// Картинку передаёт страница (обложка новости), иначе — логотип сайта.
const ogImage = new URL(image || '/images/logo.jpg', Astro.site).href;
// В meta description для Google ок 150–160 символов, но соцсети показывают
// ~125 и обрезают длинное на мобильных — для og/twitter укорачиваем по
// границе слова.
const clip = (s, n) => (s && s.length > n ? s.slice(0, n).replace(/\s+\S*$/, '') + '…' : s);
const ogDesc = clip(desc, 120);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={Astro.url.href} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="Сказочный Край" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={ogDesc} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={title || 'Сказочный Край'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={ogDesc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
  <link rel="alternate" type="application/rss+xml" title="Сказочный Край" href="/feed.xml" />
  {/* PWA разделов — порт app/layout.php и council/layout.php: манифест и мета
      только для /poselenie/* и /sovet/*. На публичных страницах «установить
      как приложение» быть не должно: там нет сессии, а ярлык открывал бы
      пустой кабинет. У совета свой манифест (manifest-sovet, scope '/sovet/')
      и своя подпись на iOS. */}
  {(bare || sovet) && (
    <>
      <link rel="manifest" href={sovet ? '/poselenie/manifest-sovet.webmanifest' : '/poselenie/manifest.webmanifest'} />
      <meta name="theme-color" content="#008757" />
      <link rel="apple-touch-icon" href={sovet ? '/poselenie/assets/icons/icon-192.png' : '/images/app-icons/icon-192.png'} />
      <meta name="mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-capable" content="yes" />
      <meta name="apple-mobile-web-app-status-bar-style" content="default" />
      <meta name="apple-mobile-web-app-title" content={sovet ? 'Совет' : 'Сказочный Край'} />
      {/* scope '/' обязателен: файл лежит на том же пути, где легаси отдавал SW со
          Service-Worker-Allowed: / (см. headers в vercel.json). Сужать scope до
          /poselenie нельзя — у вернувшихся жителей уже зарегистрирован SW со
          scope '/', и браузер сверяет его по скрипту на этом же пути. */}
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/poselenie/sw.js', { scope: '/' }).catch(function () {});
          });
        }
      </script>
    </>
  )}
  <!-- Прячем не загрузившиеся картинки вместе с их обёрткой (figure/ссылка).
       В старых постах 2013–2016 есть ~сотня битых ссылок на утраченные ещё в
       WordPress файлы — так на сайте не будет «сломанных» иконок и пустых
       рамок с подписями. Заодно страхует от любого будущего 404 картинки.
       is:inline + capture-фаза: слушатель регистрируется до загрузки img,
       а ресурсные ошибки <img> не всплывают, поэтому ловим их на capture. -->
  <script is:inline>
    (function () {
      function hideBroken(img) {
        if (!img || img.tagName !== 'IMG') return;
        // Картинка без src — отложенная загрузка (data-src подставит скрипт):
        // complete у неё true, а naturalWidth 0, и без этой проверки она
        // считалась бы битой и пряталась ещё до своего открытия.
        if (!img.getAttribute('src')) return;
        var fig = img.closest ? img.closest('figure') : null;
        if (fig) { fig.style.display = 'none'; return; }
        var a = img.parentElement;
        if (a && a.tagName === 'A' && a.children.length === 1) { a.style.display = 'none'; return; }
        img.style.display = 'none';
      }
      window.addEventListener('error', function (e) {
        var t = e && e.target;
        if (t && t.tagName === 'IMG') hideBroken(t);
      }, true);
      document.addEventListener('DOMContentLoaded', function () {
        var imgs = document.querySelectorAll('img');
        for (var i = 0; i < imgs.length; i++) {
          if (imgs[i].complete && imgs[i].naturalWidth === 0) hideBroken(imgs[i]);
        }
      });
    })();
  </script>
</head>
<body>
  {/* Стиль раздела совета — council/layout.php грузит residents.css единственным
      и после него не подключает больше ничего. Astro же поднимает свои бандлы в
      конец <head>, так что link в head оказался бы ДО них — глобальные правила
      сайта (.btn и т.п.) перебивали бы стили разделов. В теле страницы link идёт
      после всех бандлов и применяется последним, как в легаси.
      ?v= нужен из-за immutable-кэша в vercel.json: при обновлении файла просто
      меняется версия (в легаси её считал asset_ver по mtime). */}
  {sovet && <link rel="stylesheet" href="/poselenie/assets/residents.css?v=20261112" />}
  <a href="#main" class="skip">Перейти к содержанию</a>
  {/* bare — экран приложения (лаунчер жителей): без сайтового хедера/футера.
      TelegramMiniApp остаётся — он нужен внутри. */}
  {!bare && <Header />}
  <main id="main">
    <slot />
  </main>
  {!bare && <Footer />}
  <TelegramMiniApp />
</body>
</html>
