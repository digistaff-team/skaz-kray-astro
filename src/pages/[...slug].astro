---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageArticle from '../components/PageArticle.astro';
import PostArticle from '../components/PostArticle.astro';
import CategoryList from '../components/CategoryList.astro';
import { categories, catUrl } from '../data/categories.js';
import { sortByDateDesc, excerptFrom } from '../lib/utils.js';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const posts = await getCollection('posts');
  const paths = [];
  const seen = new Set();
  const add = (slug, props) => {
    if (seen.has(slug)) { console.warn(`[route] duplicate slug skipped: ${slug}`); return; }
    seen.add(slug);
    paths.push({ params: { slug }, props });
  };

  // Pages at their preserved (possibly nested) permalink
  for (const entry of pages) {
    const slug = entry.data.permalink.replace(/^\/|\/$/g, '');
    if (!slug) continue;
    add(slug, { type: 'page', entry });
  }

  // Posts at /<slug>/
  for (const entry of posts) add(entry.slug, { type: 'post', entry });

  // Category listings at /category/<nested>/
  const postsByCat = {};
  for (const p of posts)
    for (const cs of p.data.categories) (postsByCat[cs] ||= []).push(p);

  for (const cat of categories) {
    const catPosts = (postsByCat[cat.slug] || []).slice().sort(sortByDateDesc);
    const children = categories.filter((c) => c.parent === cat.id);
    const childHasPosts = children.some((c) => (postsByCat[c.slug] || []).length > 0);
    // Top-level categories are linked from the nav — always generate them
    // (with a graceful "no posts yet" state) so a freshly-added empty
    // section like "Новости" doesn't dead-link until its first post lands.
    // Sub-categories (e.g. individual поместья) stay hidden until used,
    // to avoid cluttering listings with unused legacy taxonomy.
    if (cat.parent !== 0 && catPosts.length === 0 && !childHasPosts) continue;
    const slug = catUrl(cat).replace(/^\/|\/$/g, '');
    add(slug, { type: 'category', cat, posts: catPosts, children: children.filter((c) => (postsByCat[c.slug] || []).length > 0) });
  }

  return paths;
}

const { type, entry, cat, posts, children } = Astro.props;

let title, description;
if (type === 'category') {
  title = cat.name;
  description = `Записи в рубрике «${cat.name}» — поселение родовых поместий Сказочный Край.`;
} else {
  title = entry.data.title;
  description = entry.data.seoDescription || (type === 'post' ? excerptFrom(entry, 160) : undefined);
}
---
<Base title={title} description={description}>
  {type === 'page' && <PageArticle entry={entry} />}
  {type === 'post' && <PostArticle entry={entry} />}
  {type === 'category' && <CategoryList cat={cat} posts={posts} children={children} />}
</Base>
