---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Кабинет жителя"
  description="Портал жителей поселения «Сказочный Край»."
  noindex
>
  <div class="wrap app">
    <header class="app-head">
      <img class="app-logo" src="/images/Logo_SK_204x204.png" alt="" width="56" height="56" />
      <div class="app-hello">
        <b>Сказочный Край</b>
        <span id="appHello">Загружаем кабинет…</span>
      </div>
      <!-- Иконки вверху справа — порт .app-head-actions из app/home.php.
           Капля открывает панель уровня воды (порт partials/water.php);
           пин открывает оверлей с картой (порт partials/map.php). -->
      <div class="app-head-actions">
        <button
          type="button"
          class="app-map js-water-open"
          id="waterOpen"
          aria-label="Уровень воды в Шебше"
          title="Уровень воды в Шебше"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 2c3.5 5 7 8.5 7 13a7 7 0 0 1-14 0c0-4.5 3.5-8 7-13Z"></path>
            <path d="M9.5 17.5a2.5 2.5 0 0 0 2.5 2.5"></path>
          </svg>
        </button>
        <button
          type="button"
          class="app-map js-map-open"
          id="mapOpen"
          aria-label="Карта поселения"
          title="Карта поселения"
        >
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </button>
      </div>
    </header>

    <p id="appStatus" class="app-status" role="status">Проверяем доступ…</p>

    <!-- Баннер дневников над сеткой — порт home.php (широкий .app-diary;
         плитки dnevniki в сетке нет намеренно). Скрывается, пока нет данных
         или раздел выключен. -->
    <div id="diaryBanner" class="diary-wrap" hidden></div>

    <div id="appGrid" class="app-grid" hidden></div>

    <noscript>
      <p class="app-status">Нужен включённый JavaScript. Откройте портал через бота @SkazKray_bot.</p>
    </noscript>
  </div>

  <!-- Полноэкранная карта поселения — порт residents/src/templates/partials/map.php.
       Картинку тянем лениво при первом открытии: она весит ~1 МБ, а скрытый
       контейнер загрузку не отменяет — иначе её качала бы каждая страница портала. -->
  <div class="map-overlay" id="mapOverlay" hidden>
    <button type="button" class="map-close" id="mapClose" aria-label="Закрыть карту" title="Закрыть">&times;</button>
    <div class="map-scroll" id="mapScroll">
      {/* ?v= как asset_ver() в легаси: кэш годится держать вечно,
          а обновление карты подхватывается сменой версии. */}
      <img
        data-src="/poselenie/assets/karta-sk.png?v=20260901"
        alt="Карта поселения «Сказочный Край»"
        class="map-img"
        id="mapImg"
      />
    </div>
  </div>

  <!-- Модалка «Уровень воды в Шебше» — порт residents/src/templates/partials/water.php.
       Содержимое подгружается при первом открытии: замер спрашивать на каждой
       странице портала не нужно (так же лениво, как картинка карты). -->
  <div class="water-overlay" id="waterOverlay" hidden>
    <div class="water-card" role="dialog" aria-modal="true" aria-label="Уровень воды в Шебше">
      <button type="button" class="water-close" id="waterClose" aria-label="Закрыть" title="Закрыть">&times;</button>
      <h2 class="water-title">Река Шебш</h2>
      <div class="water-content" id="waterContent"><p class="water-empty">Смотрим уровень…</p></div>
    </div>
  </div>

  <!-- Домашний экран приложения — порт residents/src/templates/app/home.php:
       приветствие + сетка плиток разделов. Нет сессии → страница входа; нет
       поместья → выбор поместья (первый вход). -->
  <script is:inline>
    (function () {
      var TOKEN_KEY = 'skazV2Token';

      // Порядок плиток — как в app/home.php. href есть только у разделов,
      // которые уже есть на Astro-сайте; остальные рисуем с бейджем «скоро»,
      // чтобы не вести в 404. Раздел без строки в app_sections не показывается.
      // Плитки «Дневники поместий» здесь нет намеренно — как в home.php:
      // на дневники ведёт широкий баннер над сеткой (#diaryBanner).
      var TILES = [
        { key: 'sosedi', title: 'Наши<br>соседи', sub: 'справочник поселения', href: '/poselenie/sosedi/', ready: true },
        {
          key: 'moye-pomestie',
          title: 'Наше<br>поместье',
          sub: 'личный кабинет семьи',
          href: '/poselenie/moye-pomestie/',
          ready: true
        },
        { key: 'knigi', title: 'Книги', sub: 'библиотека поселения', href: '/poselenie/knigi/', ready: true },
        { key: 'instrumenty', title: 'Инструменты', sub: 'арсенал поселения', href: '/poselenie/instrumenty/', ready: true },
        { key: 'obshchiy-dom', title: 'Общий дом', sub: 'бронирование и отчёт', href: '/poselenie/obshchiy-dom/', ready: true },
        { key: 'yarmarka', title: 'Ярмарка', sub: 'рынок поселения', href: '/poselenie/yarmarka/', ready: true },
        { key: 'zakupki', title: 'Закупки', sub: 'оптом вскладчину', href: '/poselenie/zakupki/', ready: true },
        { key: 'poezdki', title: 'Поездки', sub: 'попутчики и доставка' }
      ];

      var statusEl = document.getElementById('appStatus');
      var helloEl = document.getElementById('appHello');
      var gridEl = document.getElementById('appGrid');
      var bannerEl = document.getElementById('diaryBanner');
      function show(msg) { if (statusEl) statusEl.textContent = msg; }

      function authHeaders() {
        var t = '';
        try { t = window.sessionStorage.getItem(TOKEN_KEY) || ''; } catch (e) {}
        return t ? { Authorization: 'Bearer ' + t } : {};
      }

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }

      // Статус последней записи — порт diary_status_line (helpers.php).
      function diaryStatusLine(status) {
        var map = { pending: 'на проверке', published: 'опубликована', rejected: 'отклонена' };
        return 'Ваш дневник: последняя запись ' + (map[status] || 'в дневнике');
      }

      // Баннер дневников над сеткой — порт home.php (широкий блок .app-diary,
      // плитки для раздела в сетке нет). Показывается только при включённом
      // разделе dnevniki: сервер отдаёт 403 и баннер просто не рисуется.
      function renderDiaryBanner(d) {
        var html = '';
        if (d.count > 0) {
          html += '<a class="diary" href="/poselenie/dnevniki/">' +
            '<b>' + esc(diaryStatusLine(d.latestStatus)) + '</b>' +
            '<span>' + esc(d.latestTitle) + '</span></a>';
        } else {
          html += '<a class="diary" href="/poselenie/dnevnik/novaya/">' +
            '<b>Дневник нашего поместья</b>' +
            '<span>Добавьте первую запись</span></a>';
        }
        if (d.otherDiaries && d.otherDiaries.length) {
          html += '<div class="diary-label">Новое в дневниках соседей</div>';
          d.otherDiaries.forEach(function (o) {
            // Легаси вело на /dnevniki/{id} — на статике такого URL нет,
            // страница ленты открывает запись по ?entry= (инлайн-читалка).
            html += '<a class="diary diary--other" href="/poselenie/dnevniki/?entry=' + o.id + '">' +
              '<b>' + esc(o.family) + '</b>' +
              '<span>' + esc(o.title) + '</span></a>';
          });
        }
        bannerEl.innerHTML = html;
        bannerEl.hidden = false;
      }

      function loadDiaryBanner() {
        fetch('/api/diary/dashboard', { credentials: 'include', cache: 'no-store', headers: authHeaders() })
          .then(function (r) {
            if (r.status === 401) { window.location.replace('/poselenie/tg/'); return null; }
            // 403 — раздел выключен админом: баннера нет, как в home.php.
            if (!r.ok) return null;
            return r.json();
          })
          .then(function (d) { if (d) renderDiaryBanner(d); })
          .catch(function () {});
      }

      function render(sections) {
        var enabled = {};
        sections.forEach(function (s) { enabled[s.key] = true; });
        var html = '';
        TILES.forEach(function (t) {
          if (t.key !== 'moye-pomestie' && !enabled[t.key]) return;
          if (t.ready && t.href) {
            html += '<a class="tile" href="' + t.href + '"><b>' + t.title + '</b><span>' + t.sub + '</span></a>';
          } else {
            html += '<div class="tile tile--soon"><b>' + t.title + '</b><span>' + t.sub + '</span>' +
                    '<i class="tile-soon">скоро</i></div>';
          }
        });
        gridEl.innerHTML = html;
        gridEl.hidden = false;
      }

      fetch('/api/cabinet', { credentials: 'include', cache: 'no-store', headers: authHeaders() })
        .then(function (r) {
          if (r.status === 401) { window.location.replace('/poselenie/tg/'); return null; }
          return r.json().then(function (data) { return { ok: r.ok, data: data }; });
        })
        .then(function (res) {
          if (!res) return;
          if (!res.ok) throw new Error('cabinet http ' + res.ok);
          var d = res.data || {};
          if (!d.hasHousehold) {
            show('Сначала привяжите ваше поместье…');
            window.setTimeout(function () {
              window.location.replace('/poselenie/moye-pomestie/vybor/');
            }, 600);
            return;
          }
          // Подпись под названием — порт AppController::home: название
          // привязанного поместья, а если его ещё нет — имя семьи.
          var estate = (d.estateName || '').trim();
          if (helloEl) {
            helloEl.textContent = estate !== ''
              ? 'Поместье «' + estate + '»'
              : (d.family && d.family.name) || 'Житель';
          }
          render(d.sections || []);
          loadDiaryBanner();
          show('');
        })
        .catch(function () {
          show('Не удалось загрузить кабинет. Откройте портал через бота @SkazKray_bot.');
        });
    })();
  </script>

  <!-- Карта: порт логики из residents/src/templates/partials/map.php —
       пинч-зум двумя пальцами, пан одним, двойной тап, на десктопе колесо
       и перетаскивание. state (s/tx/ty) и границы зума как в легаси. -->
  <script is:inline>
    (function () {
      var openers = document.querySelectorAll('.js-map-open');
      var overlay = document.getElementById('mapOverlay');
      var closeBtn = document.getElementById('mapClose');
      var scroll = document.getElementById('mapScroll');
      var img = document.getElementById('mapImg');
      if (!openers.length || !overlay) return;

      var s = 1, tx = 0, ty = 0, MIN = 1, MAX = 6;
      function apply() { img.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + s + ')'; }
      function reset() { s = 1; tx = 0; ty = 0; apply(); }
      function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }
      function crect() { return scroll.getBoundingClientRect(); }

      // Масштаб вокруг точки (px,py в координатах контейнера); центр — начало отсчёта transform.
      function zoomTo(ns, px, py) {
        ns = clamp(ns, MIN, MAX);
        var r = crect(), cx = r.width / 2, cy = r.height / 2;
        var ix = (px - cx - tx) / s, iy = (py - cy - ty) / s;
        tx = px - cx - ix * ns; ty = py - cy - iy * ns;
        s = ns;
        if (s <= 1.001) { s = 1; tx = 0; ty = 0; }
        apply();
      }

      function show() {
        // Снимаем display:none, который мог проставить скрипт из Base.astro:
        // у <img> без src complete === true и naturalWidth === 0, поэтому
        // ленивая картинка попадает под его проверку «битых» и прячется.
        img.style.display = '';
        if (!img.getAttribute('src')) { img.src = img.getAttribute('data-src') || ''; }
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        reset();
      }
      function hide() {
        overlay.hidden = true;
        document.body.style.overflow = '';
        reset();
      }
      for (var i = 0; i < openers.length; i++) {
        openers[i].addEventListener('click', show);
      }
      closeBtn.addEventListener('click', hide);
      // Клик по краю тёмного фона (мимо контейнера с картой) — закрывает.
      overlay.addEventListener('click', function (e) { if (e.target === overlay) hide(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !overlay.hidden) hide(); });

      // --- Сенсор: пинч-зум двумя пальцами, панорамирование одним, двойной тап ---
      var prevDist = 0, lastX = 0, lastY = 0, panning = false, lastTap = 0, isTouch = false;
      function dist(t) { return Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY); }
      function midC(t) {
        var r = crect();
        return { x: (t[0].clientX + t[1].clientX) / 2 - r.left, y: (t[0].clientY + t[1].clientY) / 2 - r.top };
      }

      scroll.addEventListener('touchstart', function (e) {
        isTouch = true;
        if (e.touches.length === 2) { prevDist = dist(e.touches); }
        else if (e.touches.length === 1) {
          panning = s > 1; lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
          var now = e.timeStamp || 0;
          if (now - lastTap < 300) {           // двойной тап — приблизить/сбросить
            e.preventDefault();                // гасим синтетический dblclick браузера
            var r = crect();
            zoomTo(s > 1 ? 1 : 2.5, e.touches[0].clientX - r.left, e.touches[0].clientY - r.top);
            lastTap = 0;
          } else { lastTap = now; }
        }
      }, { passive: false });

      scroll.addEventListener('touchmove', function (e) {
        if (e.touches.length === 2) {
          e.preventDefault();
          var nd = dist(e.touches); if (!prevDist) { prevDist = nd; return; }
          var m = midC(e.touches);
          zoomTo(s * nd / prevDist, m.x, m.y);
          prevDist = nd;
        } else if (e.touches.length === 1 && panning) {
          e.preventDefault();
          tx += e.touches[0].clientX - lastX; ty += e.touches[0].clientY - lastY;
          lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
          apply();
        }
      }, { passive: false });

      scroll.addEventListener('touchend', function (e) {
        if (e.touches.length < 2) prevDist = 0;
        if (e.touches.length === 0) panning = false;
      });

      // --- Мышь (десктоп): колесо — зум к курсору, перетаскивание, двойной клик ---
      scroll.addEventListener('wheel', function (e) {
        e.preventDefault();
        var r = crect();
        zoomTo(s * (e.deltaY < 0 ? 1.15 : 1 / 1.15), e.clientX - r.left, e.clientY - r.top);
      }, { passive: false });
      var mdown = false, mx = 0, my = 0;
      scroll.addEventListener('mousedown', function (e) {
        if (s > 1) { mdown = true; mx = e.clientX; my = e.clientY; img.style.cursor = 'grabbing'; e.preventDefault(); }
      });
      window.addEventListener('mousemove', function (e) {
        if (mdown) { tx += e.clientX - mx; ty += e.clientY - my; mx = e.clientX; my = e.clientY; apply(); }
      });
      window.addEventListener('mouseup', function () { mdown = false; img.style.cursor = 'grab'; });
      scroll.addEventListener('dblclick', function (e) {
        if (isTouch) return;
        var r = crect();
        zoomTo(s > 1 ? 1 : 2.5, e.clientX - r.left, e.clientY - r.top);
      });
    })();
  </script>

  <!-- Уровень воды: порт логики из partials/water.php — ленивый fetch панели при
       первом открытии и закрытие по Escape/фону. Данные приходят JSON от
       GET /api/water (тот же panel(), что у легаси-фрагмента water_panel.php),
       разметку панели строим здесь же. -->
  <script is:inline>
    (function () {
      var opener = document.querySelector('.js-water-open');
      var overlay = document.getElementById('waterOverlay');
      var closeBtn = document.getElementById('waterClose');
      var box = document.getElementById('waterContent');
      if (!opener || !overlay) return;

      var loaded = false;

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }

      // Панель — порт water_panel.php: крупная цифра запаса до кромки моста,
      // подпись уровня и изменений, спарклайн за сутки, ссылка на подробный график.
      function render(d) {
        if (!d || d.level === null) {
          box.innerHTML = '<p class="water-empty">Замер пока не получен: гидропост не ответил. Попробуйте позже.</p>';
          return;
        }
        var html =
          '<div class="water-gap water-gap--' + esc(d.status || 'calm') + '">' +
            '<b>' + esc(d.gapLabel || '') + '</b>' +
            '<span>' + (d.flooded ? 'выше нижней кромки моста' : 'до нижней кромки моста') + '</span>' +
          '</div>' +
          '<p class="water-meta">Уровень ' + esc(d.levelLabel || '') + ' БСВ · ' + esc(d.changeLabel || '') +
            '<br>Прошлый замер был в ' + esc(d.measuredAt || '') + '</p>';

        var c = d.chart;
        if (c) {
          html +=
            '<svg class="water-chart" viewBox="0 0 ' + Number(c.w) + ' ' + Number(c.h) + '" role="img"' +
              ' aria-label="Уровень воды за последние ' + Number(c.days) + ' суток">' +
              '<polygon class="water-chart-area" points="' + esc(c.area) + '"></polygon>' +
              '<polyline class="water-chart-line" points="' + esc(c.poly) + '"></polyline>';
          (c.marks || []).forEach(function (m) {
            html +=
              '<line class="water-chart-mark" x1="0" y1="' + Number(m.y) + '"' +
                ' x2="' + Number(c.w) + '" y2="' + Number(m.y) + '"></line>' +
              '<text class="water-chart-mark-label" x="2" y="' + (Number(m.y) - 3) + '">' + esc(m.label) + '</text>';
          });
          html += '</svg>' +
            '<div class="water-axis"><span>' + esc(c.firstDate) + '</span>' +
              '<span>' + esc(c.rangeLabel) + '</span><span>' + esc(c.lastDate) + '</span></div>';
        } else {
          html += '<p class="water-meta">История пока копится — диаграмма появится через сутки наблюдений.</p>';
        }

        html +=
          '<p class="water-note">Данные гидропоста на мосту, замер каждый час ' +
            '<a href="https://shebsh-water-level.vercel.app" target="_blank" rel="noopener">Подробный график</a></p>';
        box.innerHTML = html;
      }

      function load() {
        var t = '';
        try { t = window.sessionStorage.getItem('skazV2Token') || ''; } catch (e) {}
        fetch('/api/water', {
          credentials: 'include',
          cache: 'no-store',
          headers: t ? { Authorization: 'Bearer ' + t } : {}
        })
          .then(function (r) {
            if (!r.ok) { throw new Error(r.status); }
            return r.json();
          })
          .then(function (d) { loaded = true; render(d); })
          .catch(function () {
            box.innerHTML = '<p class="water-empty">Не удалось получить замер. Проверьте связь и откройте снова.</p>';
          });
      }

      function show() {
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        if (!loaded) { load(); }
      }
      function hide() {
        overlay.hidden = true;
        document.body.style.overflow = '';
      }

      opener.addEventListener('click', show);
      closeBtn.addEventListener('click', hide);
      // Клик по тёмному фону мимо карточки — закрывает.
      overlay.addEventListener('click', function (e) { if (e.target === overlay) hide(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !overlay.hidden) hide(); });
    })();
  </script>
</Base>

<style>
  .app {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  /* Шапка лаунчера — построчный порт .app-head / .app-logo / .app-hello
     из residents.css. Размеры и скругления держим те же (48px логотип,
     8px зазор, 20px название), иначе кабинет на сайте и в приложении
     разъезжается. Отличие только одно: там .app-head был max-width: 460px
     (мобильный лаунчер), здесь страница шире — сетку сжимает .app. */
  .app-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 4px 16px;
  }
  .app-logo {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    flex: none;
  }
