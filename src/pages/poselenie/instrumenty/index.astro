---
import Base from '../../../layouts/Base.astro';
---
<Base
  title="Инструменты поселения"
  description="Арсенал инструментов жителей «Сказочного Края»."
  noindex
>
  <div class="wrap sec">
    <div class="head">
      <h1>Инструменты поселения</h1>
      <a class="btn btn--solid" href="/poselenie/instrumenty/novyy/">+ Добавить</a>
    </div>
    <p class="meta">
      Общий арсенал поселения: запросите инструмент у соседа или добавьте
      свой. Запрос подтверждает владелец, после использования инструмент
      возвращается ему.
    </p>

    <nav class="tabs">
      <button type="button" id="tabCatalog" class="tab tab--on">Каталог</button>
      <button type="button" id="tabMine" class="tab">Мои инструменты</button>
    </nav>

    <p id="flash" class="flash" hidden></p>
    <p id="secStatus" class="meta" role="status">Загружаем…</p>

    <div id="viewCatalog">
      <form class="filters" id="filters" onsubmit="return false">
        <input type="search" id="fq" placeholder="Название или категория" aria-label="Поиск по инструментам" autocomplete="off" />
        <select id="fg" aria-label="Категория"><option value="">Все категории</option></select>
        <select id="fs" aria-label="Статус">
          <option value="">Любой статус</option>
          <option value="available">свободен</option>
          <option value="on_loan">на руках</option>
          <option value="maintenance">недоступен</option>
        </select>
      </form>
      <div id="grid" class="grid"></div>
    </div>

    <div id="viewMine" hidden>
      <section>
        <h2>Я делюсь</h2>
        <div id="myList" class="list"></div>
      </section>
      <section>
        <h2>Займы на мои инструменты</h2>
        <div id="inList" class="list"></div>
      </section>
      <section>
        <h2>Я взял(а) в пользование</h2>
        <div id="outList" class="list"></div>
      </section>
    </div>

    <!-- Карточка инструмента: показ + запрос + правка (порт tool/show.php;
         отдельный URL /instrumenty/{id} на статическом хостинге не собрать). -->
    <section id="detail" class="panel" hidden>
      <div class="panel-head">
        <h2 id="dTitle"></h2>
        <span id="dStatus" class="st"></span>
      </div>
      <div id="dInfo"></div>

      <div id="dOwner" hidden>
        <p class="meta">Это ваш инструмент — управление и заявки в разделе «Мои инструменты».</p>
        <div class="actions">
          <button type="button" id="dEdit" class="btn">Редактировать</button>
          <button type="button" class="btn d-close">Закрыть</button>
        </div>
        <div id="dHistory" hidden>
          <h3>История займов</h3>
          <ul id="dHistoryList" class="history"></ul>
        </div>
        <form id="editForm" class="form" hidden>
          <label>Название <input type="text" id="eName" maxlength="200" required /></label>
          <p class="err" id="eNameErr" hidden></p>
          <label>Категория <input type="text" id="eCat" maxlength="80" list="catList" /></label>
          <label>Состояние
            <select id="eCond">
              <option value="">— выберите —</option>
              <option>Новое</option>
              <option>Хорошее</option>
              <option>Потрёпанное</option>
            </select>
          </label>
          <label>Статус
            <select id="eStatus">
              <option value="available">Инструмент свободен</option>
              <option value="on_loan">Инструмент на руках</option>
            </select>
          </label>
          <label>Условия использования <input type="text" id="eTerms" maxlength="200" /></label>
          <label>Описание <textarea id="eDesc" rows="4"></textarea></label>
          <p class="meta">Фото добавим позже.</p>
          <div class="actions">
            <button type="submit" class="btn btn--solid">Сохранить</button>
            <button type="button" class="btn d-close">Отмена</button>
          </div>
        </form>
      </div>

      <div id="dRequest" hidden>
        <h3>Запросить инструмент</h3>
        <form id="reqForm" class="form">
          <label>На какой срок нужен (до какого числа), необязательно
            <input type="date" id="rDue" />
          </label>
          <label>Сообщение владельцу (необязательно)
            <textarea id="rMsg" rows="3" placeholder="Когда удобно забрать, на сколько…"></textarea>
          </label>
          <div class="actions">
            <button type="submit" class="btn btn--solid">Отправить запрос</button>
            <button type="button" class="btn d-close">Закрыть</button>
          </div>
        </form>
      </div>

      <div id="dUnavailable" hidden>
        <p class="meta" id="dUnavailText"></p>
        <div class="actions"><button type="button" class="btn d-close">Закрыть</button></div>
      </div>
    </section>

    <datalist id="catList"></datalist>
    <p class="foot"><a href="/poselenie/">На главную</a></p>
  </div>

  <script is:inline>
    (function () {
      var TOKEN_KEY = 'skazV2Token';
      var BASE = '/api/tools';
      var statusEl = document.getElementById('secStatus');
      var flashEl = document.getElementById('flash');
      var gridEl = document.getElementById('grid');
      var fq = document.getElementById('fq');
      var fg = document.getElementById('fg');
      var fsEl = document.getElementById('fs');
      var myList = document.getElementById('myList');
      var inList = document.getElementById('inList');
      var outList = document.getElementById('outList');
      var detail = document.getElementById('detail');
      var viewCatalog = document.getElementById('viewCatalog');
      var viewMine = document.getElementById('viewMine');
      var tools = [];
      var mine = { tools: [], incoming: [], borrowings: [] };
      var current = null;

      function show(msg) { if (statusEl) statusEl.textContent = msg; }
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function ruDate(iso) {
        if (!iso) return '';
        var d = new Date(iso);
        if (isNaN(d)) return String(iso).slice(0, 10);
        return d.toLocaleDateString('ru-RU');
      }
      function statusLabel(s) {
        return s === 'on_loan' ? 'на руках' : s === 'maintenance' ? 'недоступен'
          : s === 'hidden' ? 'скрыт' : 'свободен';
      }
      function statusCls(s) {
        return s === 'available' ? 'st--free' : s === 'on_loan' ? 'st--loan'
          : s === 'maintenance' ? 'st--maint' : 'st--hidden';
      }
      function loanLabel(s) {
        return s === 'requested' ? 'ожидает решения' : s === 'on_loan' ? 'на руках'
          : s === 'returned' ? 'возвращён' : s === 'declined' ? 'отклонён' : 'отменён';
      }
      function authHeaders() {
        var t = '';
        try { t = window.sessionStorage.getItem(TOKEN_KEY) || ''; } catch (e) {}
        return t ? { Authorization: 'Bearer ' + t } : {};
      }
      function api(url, opts) {
        opts = opts || {};
        opts.credentials = 'include';
        opts.cache = 'no-store';
        var headers = authHeaders();
        if (opts.body !== undefined) headers['Content-Type'] = 'application/json';
        opts.headers = headers;
        return fetch(url, opts).then(function (r) {
          if (r.status === 401) { window.location.replace('/poselenie/tg/'); return Promise.reject({ auth: true }); }
          return r.json().then(function (d) {
            if (r.status === 403 && d && d.reason === 'no_household') {
              window.location.replace('/poselenie/moye-pomestie/vybor/');
              return Promise.reject({ noHousehold: true });
            }
            return { status: r.status, ok: r.ok, data: d };
          });
        });
      }

      try {
        var f = window.sessionStorage.getItem('skazToolFlash');
        if (f) {
          window.sessionStorage.removeItem('skazToolFlash');
          flashEl.textContent = f;
          flashEl.hidden = false;
        }
      } catch (e) {}

      function switchTab(which) {
        var mineOn = which === 'mine';
        viewMine.hidden = !mineOn;
        viewCatalog.hidden = mineOn;
        document.getElementById('tabMine').classList.toggle('tab--on', mineOn);
        document.getElementById('tabCatalog').classList.toggle('tab--on', !mineOn);
        detail.hidden = true;
      }
      document.getElementById('tabCatalog').addEventListener('click', function () { switchTab('catalog'); });
      document.getElementById('tabMine').addEventListener('click', function () {
        switchTab('mine');
        history.replaceState(null, '', '#moi');
      });
      if (window.location.hash === '#moi') switchTab('mine');

      function renderCategories() {
        var seen = {};
        var html = '<option value="">Все категории</option>';
        var list = '';
        tools.forEach(function (t) {
          var c = (t.category || '').trim();
          if (!c || seen[c]) return;
          seen[c] = true;
          html += '<option value="' + esc(c) + '">' + esc(c) + '</option>';
          list += '<option value="' + esc(c) + '"></option>';
        });
        fg.innerHTML = html;
        document.getElementById('catList').innerHTML = list;
      }

      function renderCatalog() {
        var q = (fq.value || '').trim().toLowerCase();
        var cat = fg.value;
        var st = fsEl.value;
        var shown = tools.filter(function (t) {
          if (cat && (t.category || '') !== cat) return false;
          if (st && t.status !== st) return false;
          if (q) {
            var hay = ((t.name || '') + ' ' + (t.category || '')).toLowerCase();
            if (hay.indexOf(q) === -1) return false;
          }
          return true;
        });
        if (!shown.length) {
          gridEl.innerHTML = tools.length
            ? '<p class="meta">Ничего не нашлось. Попробуйте изменить параметры поиска.</p>'
            : '<p class="meta">Каталог пуст. Будьте первым — <a href="/poselenie/instrumenty/novyy/">добавьте инструмент</a>.</p>';
          return;
        }
        var html = '';
        shown.forEach(function (t) {
          html += '<button type="button" class="card" data-id="' + t.id + '">' +
            '<div class="thumb"><span class="thumb-empty">🔧</span>' +
            '<span class="st ' + statusCls(t.status) + '">' + statusLabel(t.status) + '</span></div>' +
            '<div class="card-body"><strong>' + esc(t.name) + '</strong>' +
            (t.category ? '<span class="cat">' + esc(t.category) + '</span>' : '') +
            '<span class="meta">Владелец: ' + esc(t.ownerName || '') + '</span></div></button>';
        });
        gridEl.innerHTML = html;
      }
      fq.addEventListener('input', renderCatalog);
      fg.addEventListener('change', renderCatalog);
      fsEl.addEventListener('change', renderCatalog);
      gridEl.addEventListener('click', function (e) {
        var card = e.target.closest && e.target.closest('.card[data-id]');
        if (card) openDetail(Number(card.getAttribute('data-id')), false);
      });
      function hideDetailPanels() {
        document.getElementById('dOwner').hidden = true;
        document.getElementById('dRequest').hidden = true;
        document.getElementById('dUnavailable').hidden = true;
        document.getElementById('editForm').hidden = true;
        document.getElementById('dHistory').hidden = true;
      }

      function openDetail(id, startEdit) {
        api(BASE + '/' + id).then(function (res) {
          if (!res.ok) {
            show((res.data && res.data.error) || 'Инструмент не найден.');
            return;
          }
          var d = res.data;
          current = d;
          hideDetailPanels();
          document.getElementById('dTitle').textContent = d.tool.name;
          var st = document.getElementById('dStatus');
          st.textContent = statusLabel(d.tool.status);
          st.className = 'st ' + statusCls(d.tool.status);

          var info = '';
          if (d.tool.category) info += '<p><strong>Категория:</strong> ' + esc(d.tool.category) + '</p>';
          info += '<p><strong>Владелец:</strong> ' + esc(d.ownerName) + '</p>';
          if (d.tool.conditionNote) info += '<p><strong>Состояние:</strong> ' + esc(d.tool.conditionNote) + '</p>';
          if (d.tool.terms) info += '<p><strong>Условия:</strong> ' + esc(d.tool.terms) + '</p>';
          if (d.tool.description) info += '<p>' + esc(d.tool.description).replace(/\n/g, '<br>') + '</p>';
          if (d.active) {
            info += '<p class="meta">Сейчас у: ' + esc(d.active.borrowerName) +
              (d.active.dueDate ? ' · до ' + esc(d.active.dueDate) : '') + '</p>';
          }
          document.getElementById('dInfo').innerHTML = info;

          if (d.isOwner) {
            document.getElementById('dOwner').hidden = false;
            if (d.history && d.history.length) {
              document.getElementById('dHistoryList').innerHTML = d.history.map(function (h) {
                return '<li><span class="loan-st">' + loanLabel(h.status) + '</span> ' +
                  esc(h.borrowerName) + ' <span class="meta">' + ruDate(h.requestedAt) +
                  (h.returnCondition
                    ? ' · возврат: ' + (h.returnCondition === 'broken' ? 'повреждён' : 'в порядке')
                    : '') +
                  '</span></li>';
              }).join('');
              document.getElementById('dHistory').hidden = false;
            }
            if (startEdit) showEditForm(d);
          } else if (d.canRequest) {
            document.getElementById('dRequest').hidden = false;
          } else {
            document.getElementById('dUnavailText').textContent =
              d.tool.status === 'available'
                ? 'Инструмент уже запрошен.'
                : 'Инструмент сейчас недоступен (' + statusLabel(d.tool.status) + ').';
            document.getElementById('dUnavailable').hidden = false;
          }
          detail.hidden = false;
          window.scrollTo(0, detail.offsetTop - 60);
        }).catch(function (e) {
          if (!e || (!e.auth && !e.noHousehold)) show('Не удалось открыть инструмент. Попробуйте позже.');
        });
      }

      function showEditForm(d) {
        document.getElementById('eName').value = d.tool.name;
        document.getElementById('eCat').value = d.tool.category || '';
        document.getElementById('eCond').value = d.tool.conditionNote || '';
        document.getElementById('eStatus').value = d.tool.status === 'on_loan' ? 'on_loan' : 'available';
        document.getElementById('eTerms').value = d.tool.terms || '';
        document.getElementById('eDesc').value = d.tool.description || '';
        document.getElementById('eNameErr').hidden = true;
        document.getElementById('editForm').hidden = false;
        document.getElementById('dHistory').hidden = true;
      }

      function closeDetail() { detail.hidden = true; current = null; }
      Array.prototype.forEach.call(document.querySelectorAll('.d-close'), function (b) {
        b.addEventListener('click', closeDetail);
      });
      document.getElementById('dEdit').addEventListener('click', function () {
        if (current) showEditForm(current);
      });

      document.getElementById('editForm').addEventListener('submit', function (ev) {
        ev.preventDefault();
        if (!current) return;
        var errEl = document.getElementById('eNameErr');
        errEl.hidden = true;
        api(BASE + '/update/' + current.tool.id, {
          method: 'POST',
          body: JSON.stringify({
            name: document.getElementById('eName').value,
            category: document.getElementById('eCat').value,
            conditionNote: document.getElementById('eCond').value,
            status: document.getElementById('eStatus').value,
            terms: document.getElementById('eTerms').value,
            description: document.getElementById('eDesc').value
          })
        }).then(function (res) {
          var d = res.data || {};
          if (res.ok && d.ok) {
            try { window.sessionStorage.setItem('skazToolFlash', 'Изменения сохранены.'); } catch (e) {}
            window.location.reload();
            return;
          }
          if (d.errors && d.errors.name) { errEl.textContent = d.errors.name; errEl.hidden = false; return; }
          show(d.error || 'Не удалось сохранить. Попробуйте позже.');
        }).catch(function () {
          show('Сеть недоступна — попробуйте ещё раз.');
        });
      });

      document.getElementById('reqForm').addEventListener('submit', function (ev) {
        ev.preventDefault();
        if (!current) return;
        api(BASE + '/request/' + current.tool.id, {
          method: 'POST',
          body: JSON.stringify({
            dueDate: document.getElementById('rDue').value || null,
            message: document.getElementById('rMsg').value
          })
        }).then(function (res) {
          var d = res.data || {};
          if (res.ok && (d.ok || d.id)) {
            try {
              window.sessionStorage.setItem(
                'skazToolFlash',
                'Запрос отправлен владельцу — решение он увидит в разделе «Мои инструменты».'
              );
            } catch (e) {}
            window.location.reload();
            return;
          }
          show(d.error || 'Не удалось отправить запрос. Попробуйте позже.');
        }).catch(function () {
          show('Сеть недоступна — попробуйте ещё раз.');
        });
      });
      function renderMine() {
        var m = mine;

        if (!m.tools.length) {
          myList.innerHTML = '<p class="meta">Вы пока не добавили инструментов. ' +
            '<a href="/poselenie/instrumenty/novyy/">Добавить инструмент</a></p>';
        } else {
          myList.innerHTML = m.tools.map(function (t) {
            return '<div class="row"><div class="row-main">' +
              '<button type="button" class="linklike" data-open="' + t.id + '"><strong>' +
                esc(t.name) + '</strong></button>' +
              (t.category ? ' <span class="meta">' + esc(t.category) + '</span>' : '') +
              ' <span class="st ' + statusCls(t.status) + '">' + statusLabel(t.status) + '</span>' +
              (t.status === 'on_loan' && t.holder
                ? ' <span class="meta">у: ' + esc(t.holder) + '</span>' : '') +
              '</div><div class="row-actions">' +
              '<button type="button" class="linkbtn" data-open-edit="' + t.id + '">Редактировать</button>' +
              (t.status !== 'on_loan'
                ? '<button type="button" class="linkbtn" data-maint="' + t.id + '">' +
                    (t.status === 'maintenance' ? 'Готов к выдаче' : 'Недоступен') + '</button>' +
                  '<button type="button" class="linkbtn" data-hide="' + t.id + '">' +
                    (t.status === 'hidden' ? 'Показать' : 'Скрыть') + '</button>'
                : '') +
              '<button type="button" class="linkbtn danger" data-del="' + t.id + '">Удалить</button>' +
              '</div></div>';
          }).join('');
        }

        var pending = m.incoming.filter(function (l) { return l.status === 'requested'; });
        var onloan = m.incoming.filter(function (l) { return l.status === 'on_loan'; });
        var ih = '';
        if (!pending.length && !onloan.length) {
          ih = '<p class="meta">Активных займов нет.</p>';
        }
        pending.forEach(function (l) {
          ih += '<div class="row"><strong>' + esc(l.toolName) + '</strong> — запрос от ' +
            esc(l.borrowerName) +
            (l.dueDate ? ' <span class="meta">до ' + esc(l.dueDate) + '</span>' : '') +
            (l.message ? '<p>' + esc(l.message).replace(/\n/g, '<br>') + '</p>' : '') +
            '<div class="row-actions">' +
            '<button type="button" class="btn" data-give="' + l.id + '">Выдать</button>' +
            '<button type="button" class="linkbtn danger" data-decline="' + l.id + '">Отклонить</button>' +
            '</div></div>';
        });
        onloan.forEach(function (l) {
          ih += '<div class="row" data-loan="' + l.id + '"><strong>' + esc(l.toolName) +
            '</strong> — на руках у ' + esc(l.borrowerName) +
            (l.dueDate ? ' <span class="meta">до ' + esc(l.dueDate) + '</span>' : '') +
            '<details class="return-box"><summary class="btn">Принять возврат</summary>' +
            '<label>Состояние при возврате<select class="ret-cond">' +
            '<option value="ok">в порядке</option>' +
            '<option value="broken">повреждён → недоступен</option>' +
            '</select></label>' +
            '<label>Заметка (необязательно)<input type="text" class="ret-note" maxlength="500"></label>' +
            '<button type="button" class="btn btn--solid" data-return="' + l.id +
            '">Подтвердить возврат</button>' +
            '</details></div>';
        });
        inList.innerHTML = ih;

        if (!m.borrowings.length) {
          outList.innerHTML = '<p class="meta">Вы пока ничего не брали.</p>';
        } else {
          outList.innerHTML = m.borrowings.map(function (l) {
            return '<div class="row">' +
              '<button type="button" class="linklike" data-open="' + l.toolId + '"><strong>' +
                esc(l.toolName) + '</strong></button> ' +
              '<span class="loan-st">' + loanLabel(l.status) + '</span> ' +
              '<span class="meta">владелец: ' + esc(l.ownerName || '') +
              (l.dueDate ? ' · до ' + esc(l.dueDate) : '') + '</span>' +
              (l.status === 'requested'
                ? '<div class="row-actions"><button type="button" class="linkbtn" data-cancel="' + l.id +
                  '">Отменить запрос</button></div>'
                : '') +
              '</div>';
          }).join('');
        }
      }

      // (действия вкладки — см. выше)
      // Действия вкладки «Мои инструменты» — делегирование (как в книгах).
      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        function idOf(attr) {
          var el = t.closest('[' + attr + ']');
          return Number(el.getAttribute(attr));
        }
        function post(path, body) {
          return api(BASE + path, { method: 'POST', body: JSON.stringify(body || {}) });
        }
        function reload() { window.location.reload(); }
        function fail(msg) { return function () { show(msg); }; }

        var open = t.closest('[data-open]');
        if (open) { switchTab('catalog'); openDetail(idOf('data-open'), false); return; }
        var openEdit = t.closest('[data-open-edit]');
        if (openEdit) { switchTab('catalog'); openDetail(idOf('data-open-edit'), true); return; }

        var maint = t.closest('[data-maint]');
        if (maint) {
          post('/toggle-maintenance/' + idOf('data-maint')).then(reload)
            .catch(fail('Не удалось изменить статус. Попробуйте позже.'));
          return;
        }
        var hide = t.closest('[data-hide]');
        if (hide) {
          post('/toggle-hidden/' + idOf('data-hide')).then(reload)
            .catch(fail('Не удалось изменить видимость. Попробуйте позже.'));
          return;
        }
        var del = t.closest('[data-del]');
        if (del) {
          if (!window.confirm('Удалить инструмент?')) return;
          post('/delete/' + idOf('data-del')).then(reload)
            .catch(fail('Не удалось удалить. Попробуйте позже.'));
          return;
        }
        var give = t.closest('[data-give]');
        if (give) {
          post('/loans/give/' + idOf('data-give')).then(reload)
            .catch(fail('Не удалось выдать. Попробуйте позже.'));
          return;
        }
        var decl = t.closest('[data-decline]');
        if (decl) {
          if (!window.confirm('Отклонить запрос?')) return;
          post('/loans/decline/' + idOf('data-decline')).then(reload)
            .catch(fail('Не удалось отклонить. Попробуйте позже.'));
          return;
        }
        var ret = t.closest('[data-return]');
        if (ret) {
          var row = ret.closest('[data-loan]');
          post('/loans/return/' + idOf('data-return'), {
            condition: row.querySelector('.ret-cond').value,
            note: row.querySelector('.ret-note').value
          }).then(reload).catch(fail('Не удалось оформить возврат. Попробуйте позже.'));
          return;
        }
        var cancel = t.closest('[data-cancel]');
        if (cancel) {
          if (!window.confirm('Отменить запрос?')) return;
          post('/loans/cancel/' + idOf('data-cancel')).then(reload)
            .catch(fail('Не удалось отменить. Попробуйте позже.'));
        }
      });
      api(BASE + '/catalog')
        .then(function (c) {
          if (c.ok) {
            tools = c.data || [];
            renderCategories();
            renderCatalog();
          } else if (c && c.data && c.data.error) {
            show(c.data.error);
          }
          return api(BASE + '/mine');
        })
        .then(function (m) {
          if (!m) return;
          if (m.ok) {
            mine = m.data || { tools: [], incoming: [], borrowings: [] };
            renderMine();
            show('');
          } else if (m.data && m.data.error) {
            show(m.data.error);
          }
        })
        .catch(function (e) {
          if (!e || (!e.auth && !e.noHousehold)) {
            show('Не удалось загрузить раздел. Проверьте связь и попробуйте позже.');
          }
        });
    })();
  </script>
</Base>

