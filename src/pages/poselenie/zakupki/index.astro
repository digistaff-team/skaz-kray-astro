  .st--hidden, .list :global(.st--hidden) { opacity: 0.75; }
  .list :global(.meta) { display: block; margin-top: 0.3rem; font-size: 0.88rem; color: var(--muted); }
  .list :global(.bar),
  #dInfo :global(.bar) {
    margin-top: 0.45rem; height: 8px; border: 1px solid var(--line);
    border-radius: 999px; background: var(--ground); overflow: hidden;
  }
  .list :global(.bar-fill),
  #dInfo :global(.bar-fill) { display: block; height: 100%; background: #7aa87a; }
  .list :global(.prog-text),
  #dInfo :global(.prog-text) { margin-top: 0.25rem; font-size: 0.85rem; color: var(--muted); }
  .panel {
    margin-top: 1.4rem; padding: 1rem 1rem 1.1rem; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--ground-2);
  }
  .panel-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .panel h2 { font-size: var(--step-1); margin: 0; }
  #dInfo { margin-top: 0.5rem; }
  #dInfo :global(p) { margin: 0.4rem 0; }
  #dInfo :global(.price) { font-size: var(--step-1); }
  .list :global(.row) {
    padding: 0.7rem 0.8rem; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--ground);
  }
  .list :global(.row-main) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .list :global(.row-actions) {
    display: flex; flex-wrap: wrap; gap: 0.7rem; align-items: center; margin-top: 0.5rem;
  }
  .list :global(.linkbtn) {
    background: none; border: 0; padding: 0; font: inherit; font-size: 0.9rem;
    color: var(--muted); text-decoration: underline; cursor: pointer;
  }
  /* #dJoin и его содержимое создаётся через innerHTML — нужен :global. */
  #dJoin :global(.sub) { font-size: var(--step-1); margin: 1.4rem 0 0.5rem; }
  #dJoin :global(.meta) { color: var(--muted); font-size: 0.95rem; }
  #dJoin :global(.form label) { display: block; margin-top: 0.85rem; font-size: 0.95rem; color: var(--muted); }
  #dJoin :global(.form input) {
    display: block; width: 100%; margin-top: 0.3rem; padding: 0.5rem 0.6rem;
    font: inherit; color: inherit; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--ground);
  }
  #dJoin :global(.actions) { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1rem; }
  #dJoin :global(.err) { color: #a33; font-size: 0.92rem; margin: 0.3rem 0; }
  #dInfo :global(.meta) { color: var(--muted); font-size: 0.95rem; }
  #dInfo :global(.err) { color: #a33; font-size: 0.92rem; margin: 0.3rem 0; }
  .form label { display: block; margin-top: 0.85rem; font-size: 0.95rem; color: var(--muted); }
  .form input,
  .form textarea {
    display: block; width: 100%; margin-top: 0.3rem; padding: 0.5rem 0.6rem;
    font: inherit; color: inherit; border: 1px solid var(--line);
    border-radius: var(--radius); background: var(--ground);
  }
  .form textarea { resize: vertical; }
  .two-col { display: flex; gap: 0.7rem; }
  .two-col label { flex: 1 1 0; min-width: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1rem; }
  .err { color: #a33; font-size: 0.92rem; margin: 0.3rem 0; }
  .foot { margin-top: 2.2rem; font-size: 0.95rem; }
</style>
