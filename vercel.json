{
  "framework": "astro",
  "buildCommand": "npm ci --prefer-offline && npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/(.*)/",
      "destination": "https://residents-v2.vercel.app/api/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://residents-v2.vercel.app/api/$1"
    },
    {
      "source": "/tg-media/(.*)",
      "destination": "https://residents-v2.vercel.app/api/tg-media/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/editor/(.*)",
      "destination": "/editor/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/dnevniki-pomestiy",
      "destination": "/category/dnevniki-pomestij/",
      "permanent": true
    },
    {
      "source": "/dnevniki-pomestiy/",
      "destination": "/category/dnevniki-pomestij/",
      "permanent": true
    },
    {
      "source": "/tag/prazdnik/",
      "destination": "/o-nas/prazdniki/",
      "permanent": true
    },
    {
      "source": "/pravila/",
      "destination": "/o-nas/pravila/",
      "permanent": true
    },
    {
      "source": "/poselenie/app",
      "destination": "/poselenie/",
      "permanent": true
    },
    {
      "source": "/poselenie/app/",
      "destination": "/poselenie/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/poselenie/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/poselenie/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/poselenie/manifest-sovet.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/poselenie/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": true
  }
}
